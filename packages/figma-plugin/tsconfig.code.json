{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["@figma/plugin-typings"],
    "baseUrl": "../..",
    "paths": {
      "@figma-agent-bridge/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@figma-agent-bridge/shared/*": [
        "./packages/shared/src/*"
      ]
    }
  },
  "include": [
    "src/code.ts",
    "src/apply-layout.ts",
    "src/feed"
  ],
  "exclude": ["src/**/*.test.ts"]
}
