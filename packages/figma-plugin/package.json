{
  "name": "@figma-agent-bridge/figma-plugin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && vite build --config vite.config.ui.ts && vite build --config vite.config.code.ts",
    "watch": "concurrently 'vite build --watch --config vite.config.ui.ts' 'vite build --watch --config vite.config.code.ts'",
    "typecheck": "tsc --noEmit --project tsconfig.ui.json && tsc --noEmit --project tsconfig.code.json"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "vite": "^6.3.4",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
