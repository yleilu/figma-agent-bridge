{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "types": ["bun-types"],
    "paths": {
      "@figma-agent-bridge/shared/*": ["./packages/shared/src/*"],
      "@figma-agent-bridge/server/*": ["./packages/server/src/*"],
      "@figma-agent-bridge/relay/*": ["./packages/relay/src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "packages/figma-plugin"
  ]
}
